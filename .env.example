# ─── VNKR TECH HOLDING — Root Environment Example ─────────────────────────────
# Copy to .env and fill in real values (never commit .env)

# ── Solana ──────────────────────────────────────────────────────────────────────
SOLANA_RPC_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# ── App-Chain (EVM Genesis) ──────────────────────────────────────────────────────
APPCHAIN_RPC=http://localhost:8545
APPCHAIN_CHAIN_ID=1337

# ── TRON ────────────────────────────────────────────────────────────────────────
TRON_FULL_HOST=https://api.trongrid.io
TRON_PRIVATE_KEY=

# ── Merchant / Fiat API ──────────────────────────────────────────────────────────
DEFAULT_API_ENDPOINT=https://dev-api.vnkr.vn
BANK_WEBHOOK_SECRET=

# ── Dune Alert Bots ──────────────────────────────────────────────────────────────
DUNE_API_KEY=
DUNE_RESERVE_QUERY_ID=1234567
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
DISCORD_BOT_TOKEN=

# ── AWS / Terraform ──────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
CLOUDFLARE_ZONE_ID=b1c94362bb5f0f5c8809aa24c93fad35
CLOUDFLARE_ACCOUNT_ID=b1c94362bb5f0f5c8809aa24c93fad35
CLOUDFLARE_API_TOKEN=cfat_GNFNVsp44adAv84SEkjxYzRtH0yhuE1sVLvU1zXp12fc9029


# ── Stalwart Mail Server ─────────────────────────────────────────────────────
STALWART_HOSTNAME=mail.vnkr.vn
SMTP_HOST=mail.vnkr.vn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@vnkr.vn
SMTP_PASS=Noname@2026
EMAIL_FROM="VNKR System <no-reply@vnkr.vn>"

# ── PostgreSQL 16 — Database ────────────────────────────────────────────────
# Superuser password (used by postgres service in docker-compose)
POSTGRES_PASSWORD=vnkr_dev_password_2026

# Per-service DB passwords (must match values in deploy/db/04_roles.sql)
# Change ALL of these before deploying to any shared/staging/production environment.
DB_PASS_FIAT=CHANGE_ME_fiat_connector_2026
DB_PASS_OTC=CHANGE_ME_otc_2026
DB_PASS_INDEXER=CHANGE_ME_indexer_2026
DB_PASS_SWIFT=CHANGE_ME_swift_2026
DB_PASS_KYC_PORTAL=CHANGE_ME_kyc_portal_2026
DB_PASS_MERCHANT=CHANGE_ME_merchant_2026
DB_PASS_SANDBOX=CHANGE_ME_sandbox_2026
DB_PASS_READONLY=CHANGE_ME_readonly_2026
DB_PASS_ADMIN=CHANGE_ME_admin_2026

# Connection strings (via PgBouncer on port 5433 in Docker, direct on 5432 locally)
# DATABASE_URL is injected per-service in docker-compose; set here for local dev only.
DATABASE_URL=postgresql://postgres:vnkr_dev_password_2026@localhost:5432/vnkr

# ── Redis Event Bus ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# URL fiat-connector-api nội bộ (cho inbound credit notification bridge)
FIAT_CONNECTOR_URL=http://localhost:4001

# ── SWIFT Chain Bridge & Blockchain Relayer ──────────────────────────────────
# VNKR App-Chain EVM RPC (Hyperledger Besu)
VNKR_EVM_RPC=http://localhost:8545

# VNKRSwiftBridge.sol deployed address trên App-Chain
BRIDGE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000003

# Private key của Relayer wallet (có role oracleRelayer trong contract)
# ⚠️ KHÔNG commit giá trị thật vào git
RELAYER_PRIVATE_KEY=

# API key để swift-chain-bridge gọi swift-gateway
SWIFT_API_KEY=

# Webhook secret giữa swift-gateway và swift-chain-bridge (internal)
VNKR_INTERNAL_WEBHOOK_SECRET=

# ── FX Oracle (VNKRSwiftBridgeV2 — 1 VNKR = 1 VND) ─────────────────────────
# SBV Open API key (tỷ giá liên ngân hàng Ngân hàng Nhà nước Việt Nam)
SBV_API_KEY=

# SBV FX API URL (có thể override)
SBV_FX_API_URL=https://apiv2.sbv.gov.vn/ExchangeRates

# Vietcombank XML Feed URL (fallback tỷ giá)
VIETCOMBANK_FX_API=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx?b=10

# Phí bridge mặc định (basis points, 10 = 0.1%)
BRIDGE_FEE_BPS=10

# Phí gas cơ bản mặc định (VNKR, 18 decimals — 10000 VNKR = 10,000 VND)
DEFAULT_BASE_GAS_FEE_VNKR=10000000000000000000000

# ── SWIFT Institutional Banking ─────────────────────────────────────────────
# LAU (Local Authentication Algorithm) shared secret key — min 32 hex chars
SWIFT_LAU_KEY=

# BIC11 of the VNKR institutional member (e.g. VNKRVNVNXXX)
SWIFT_BIC_CODE=VNKRVNVN

# SWIFT API Gateway OAuth2 credentials (from SWIFT Developer Portal)
SWIFT_CONSUMER_KEY=
SWIFT_CONSUMER_SECRET=

# SWIFT Microgateway daemon URL (default: local JVM sidecar on 9003)
SWIFT_MGW_URL=http://localhost:9003

# API key for MGW internal management/monitoring APIs
SWIFT_MGW_APIKEY=

# SWIFT gpi UETR prefix (optional; for UETR generation tracing)
SWIFT_GPI_UETR_PREFIX=

# ── NODE_AUTH_TOKEN / AUTH ──────────────────────────────────────────────────────────────

NPM_TOKEN=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
