# ─── Dockerfile: swift-gateway ───────────────────────────────────────────────
# Node.js Fastify proxy (Port 4004) that bridges the monorepo to the
# SWIFT Microgateway 2.0.17 JVM process.
FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm

# Copy workspace manifests first for layer caching
COPY pnpm-workspace.yaml package.json turbo.json ./

# Shared packages required by swift-gateway
COPY packages/types         ./packages/types
COPY packages/config        ./packages/config
COPY packages/swift-adapter ./packages/swift-adapter

# Service itself (vendor/ is excluded via .dockerignore)
COPY services/swift-gateway ./services/swift-gateway

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @vnkr/swift-adapter build
RUN pnpm --filter @vnkr/swift-gateway build

# ── Runner ────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/services/swift-gateway/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/services/swift-gateway/package.json ./package.json

EXPOSE 4004
CMD ["node", "dist/index.js"]
