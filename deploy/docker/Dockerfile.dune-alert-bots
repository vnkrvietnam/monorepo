# ─── Dockerfile: dune-alert-bots ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm

COPY pnpm-workspace.yaml package.json turbo.json ./
COPY packages/types    ./packages/types
COPY packages/config   ./packages/config
COPY services/dune-alert-bots ./services/dune-alert-bots

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @vnkr/dune-alert-bots build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/services/dune-alert-bots/dist ./dist
COPY --from=builder /app/node_modules ./node_modules

# No exposed port — bot runs as a scheduled worker
CMD ["node", "dist/index.js"]
