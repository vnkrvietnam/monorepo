{
  "name": "@vnkrvietnam/api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Central API Gateway — REST endpoints for all 17 service domains",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/index.js",
    "workers": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "ws": "ts-node-dev --respawn --transpile-only src/websocket/index.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.14",
    "bullmq": "^5.7.0",
    "ws": "^8.17.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "@vnkrvietnam/types": "workspace:*",
    "@vnkrvietnam/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/speakeasy": "^2.0.8",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0"
  }
}
