{
  "name": "@vnkrvietnam/swift-adapter",
  "version": "1.0.0",
  "description": "SWIFT SDK wrapper — MT103/MT202 message builder, ISO 20022 parser, LAU signing for VNKR institutional banking",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vnkrvietnam/config": "workspace:*",
    "@vnkrvietnam/types": "workspace:*",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^4.4.1",
    "ioredis": "^5.4.1",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vnkrvietnam/vnkr-packages.git"
  }
}
